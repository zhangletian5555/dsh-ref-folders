{
  "name": "dsh-ref-folder",
  "version": "0.3.0",
  "type": "module",
  "description": "Read-only referenced folders for DeepSeek Harness sessions.",
  "license": "MIT",
  "author": {
    "name": "zhangletian5555",
    "url": "https://github.com/zhangletian5555"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangletian5555/dsh-ref-folders.git"
  },
  "homepage": "https://github.com/zhangletian5555/dsh-ref-folders#readme",
  "bugs": {
    "url": "https://github.com/zhangletian5555/dsh-ref-folders/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "read-only",
    "reference-folders"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check src/core.js && node --check src/service.js && node --check src/commands.js && node --check src/http.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  }
}
